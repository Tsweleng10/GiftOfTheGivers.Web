@model IEnumerable<VolunteerInterest>

<h2>Employee Dashboard</h2>

@if (TempData["UpdateMessage"] != null)
{
    <div class="alert alert-success">@TempData["UpdateMessage"]</div>
}

<div class="row">
    <div class="col-md-6">
        <h4>Post an Update</h4>
        <form asp-action="PostUpdate" method="post">
            <div class="form-group">
                <label>Title</label>
                <input name="title" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea name="description" class="form-control" rows="2"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Post</button>
        </form>
    </div>
    <div class="col-md-6">
        <h4>Recent Donations</h4>
        <table class="table table-sm">
            <tr><th>Donor</th><th>Amount</th><th>Date</th></tr>
            @foreach (var d in ViewBag.RecentDonations as List<Donation>)
            {
                <tr>
                    <td>@(d.IsAnonymous ? "Anonymous" : d.Donor?.FullName ?? "Unknown")</td>
                    <td>@d.Amount @d.Currency</td>
                    <td>@d.DonationDate.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </table>
    </div>
</div>

<h4>Recent Volunteer Sign-ups</h4>
<table class="table">
    <tr><th>Name</th><th>Email</th><th>Phone</th><th>Skills</th><th>Submitted</th></tr>
    @foreach (var v in Model)
    {
        <tr>
            <td>@v.FullName</td>
            <td>@v.Email</td>
            <td>@v.Phone</td>
            <td>@v.Skills</td>
            <td>@v.SubmittedAt.ToString("dd/MM/yyyy")</td>
        </tr>
    }
</table>