@model VolunteerInterest

<h2>Register as a Volunteer</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Skills"></label>
        <textarea asp-for="Skills" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="Availability"></label>
        <input asp-for="Availability" class="form-control" placeholder="e.g., Weekends, Evenings" />
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form>